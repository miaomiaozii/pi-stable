{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"*": ["./*"],
			"pi-stable-telemetry": ["./packages/telemetry/src/index.ts"],
			"pi-stable-telemetry/testing": ["./packages/telemetry/src/testing/index.ts"],
			"pi-stable-ai": ["./packages/ai/src/index.ts"],
			"pi-stable-ai/oauth": ["./packages/ai/src/oauth.ts"],
			"pi-stable-ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"pi-stable-ai/dist/*": ["./packages/ai/src/*"],
			"pi-stable-agent-core": ["./packages/agent/src/index.ts"],
			"pi-stable-agent-core/node": ["./packages/agent/src/node.ts"],
			"pi-stable-agent-core/session/testing": [
				"./packages/agent/src/harness/session/testing/index.ts"
			],
			"pi-stable-agent-core/*": ["./packages/agent/src/*"],
			"pi-stable-session-backend-sqlite-node": [
				"./packages/session-backends/sqlite-node/src/index.ts"
			],
			"pi-stable": ["./packages/coding-agent/src/index.ts"],
			"pi-stable/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"pi-stable/*": ["./packages/coding-agent/src/*"],
			"pi-stable-protocol": ["./packages/protocol/src/index.ts"],
			"pi-stable-protocol/*": ["./packages/protocol/src/*"],
			"pi-stable-client": ["./packages/client/src/index.ts"],
			"pi-stable-client/*": ["./packages/client/src/*"],
			"pi-stable-server": ["./packages/server/src/index.ts"],
			"pi-stable-server/*": ["./packages/server/src/*"],
			"typebox": ["./node_modules/typebox"],
			"pi-stable-tui": ["./packages/tui/src/index.ts"],
			"pi-stable-tui/*": ["./packages/tui/src/*"],
			"pi-stable-agent-old": ["./packages/agent-old/src/index.ts"],
			"pi-stable-agent-old/*": ["./packages/agent-old/src/*"]
		}
	},
	"include": [
		"packages/*/src/**/*",
		"packages/*/test/**/*",
		"packages/session-backends/*/src/**/*",
		"packages/session-backends/*/test/**/*",
		"packages/coding-agent/examples/**/*"
	],
	"exclude": ["**/dist/**", "packages/coding-agent/examples/extensions/gondolin/**"]
}
